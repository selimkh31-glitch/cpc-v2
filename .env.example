# Noms de variables uniquement. Ne jamais committer de valeurs (voir docs/07_CHECKLIST_ACCES.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Observabilité optionnelle (ADR-0012) — désactivée par défaut
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=
# Médias (ADR-0015) — défaut 600 s, plafond 900 s
MEDIA_SIGNED_URL_TTL=600
